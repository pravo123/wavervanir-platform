# ============================================================================
# deploy/API.env.example — PRODUCTION env template for the wavervanir-api.
# ----------------------------------------------------------------------------
# This documents EVERY environment variable the API reads, with prod guidance.
# It is the deploy-time counterpart to api/.env.example (which is dev-tuned).
#
# HOW TO USE
#   - On Render: do NOT upload this file. Use render.yaml + paste the
#     `sync: false` secrets in the Render dashboard. This file is the
#     human reference for what each one means.
#   - On any other host (Fly, a VM, Docker): copy to `.env`, fill real values,
#     and never commit the filled copy.
#
# NEVER put real secrets in this template. Placeholders only.
#
# Variable names are the exact aliases from
#   api/src/wavervanir_api/config.py  (Settings.*)
# plus the two STRIPE_PRICE_* names consumed directly in
#   api/src/wavervanir_api/plans.py.
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# CORE  (required)
# ─────────────────────────────────────────────────────────────────────────

# Deployment environment label. Drives ops guardrails:
#   - staging_guard() REFUSES to mint API keys at rest when this == "prod",
#     so a key-minting step must run against "staging".
# Use "staging" for the first hosted deploy; "prod" once live mode is approved.
# Default (if unset): "dev".
WAVERVANIR_ENV=staging

# SQLAlchemy/SQLModel database URL. REQUIRED in production.
#   - Local dev default is SQLite: sqlite:///./wavervanir_api.sqlite
#   - Production MUST be Postgres. On Render this is auto-injected from the
#     wavervanir-pg database (see render.yaml fromDatabase).
#   - If you set it by hand, use the SQLAlchemy psycopg form:
#       postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
#     (Render's raw "postgres://" string also works with SQLAlchemy's driver
#      resolution, but the explicit +psycopg form is unambiguous.)
# Default (if unset): sqlite:///./wavervanir_api.sqlite  (NOT for prod)
WAVERVANIR_DB_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/wavervanir

# Server-side pepper mixed into API-key hashing at rest. REQUIRED.
#   - MUST be a fresh, high-entropy random string (>= 24 chars; 48 recommended).
#   - Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   - On Render this is auto-generated (generateValue: true) — leave it alone.
#   - NEVER reuse the local-dev sentinel "local-dev-pepper-change-me":
#     staging_guard() refuses to mint keys while it is the sentinel or too short.
#   - Rotating this value INVALIDATES every previously issued API key.
# Default (if unset): local-dev-pepper-change-me  (UNSAFE — for dev only)
WAVERVANIR_API_KEY_PEPPER=REPLACE_WITH_48_CHAR_RANDOM_SECRET

# ─────────────────────────────────────────────────────────────────────────
# RATE LIMITS  (optional — sensible defaults exist)
# ─────────────────────────────────────────────────────────────────────────

# Daily request cap for the free/dev tier.
# Default (if unset): 100
WAVERVANIR_RATE_LIMIT_FREE=100

# Daily request cap applied to paid self-serve plans (ops override of the
# plan-catalog default in plans.py). Leave unset to use per-plan defaults.
# Default (if unset): 5000
WAVERVANIR_RATE_LIMIT_PAID=5000

# ─────────────────────────────────────────────────────────────────────────
# STRIPE  (required for billing / self-serve checkout; TEST MODE in MVP)
# ─────────────────────────────────────────────────────────────────────────

# Stripe secret key. Use a TEST-mode restricted key in MVP (sk_test_...).
# Required for /stripe/* and /onboard to function. Leave blank to disable
# billing (API still serves CBSRM to manually-minted keys).
# Default (if unset): "" (billing disabled)
STRIPE_API_KEY=sk_test_REPLACE

# Stripe webhook signing secret (whsec_...). Required to verify inbound
# Stripe events at /stripe/webhook. Obtained AFTER you register the webhook
# endpoint in the Stripe dashboard, THEN paste here and restart the service.
# Default (if unset): "" (webhook verification disabled)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# Stripe Price id for the Researcher ($49/mo) plan. Consumed by name in
# plans.py (Plan.price_env). Required for self-serve Researcher checkout.
# Default (if unset / blank): plan has no purchasable Price id.
STRIPE_PRICE_RESEARCHER=price_REPLACE_RESEARCHER

# Stripe Price id for the Pro ($499/mo) plan. Consumed by name in plans.py.
# Required for self-serve Pro checkout.
# Default (if unset / blank): plan has no purchasable Price id.
STRIPE_PRICE_PRO=price_REPLACE_PRO

# ─────────────────────────────────────────────────────────────────────────
# DATA PROVIDERS  (all OPTIONAL — providers self-disable when blank)
# ─────────────────────────────────────────────────────────────────────────

# financialdata.net — the commercial market feed (powers VIX + the advanced lenses).
FINANCIALDATA_API_KEY=
# FRED — St. Louis Fed API key (FRED-based lenses). https://fred.stlouisfed.org
FRED_API_KEY=

# Bullflow-style options-flow API key. Set EITHER this OR BULLFLOW_DATA_FILE.
# Default (if unset): "" (flow feed disabled)
BULLFLOW_API_KEY=

# Local path to a Bullflow-style data file (alternative to the API key, e.g.
# for an air-gapped or fixture-backed deploy).
# Default (if unset): "" (no local flow file)
BULLFLOW_DATA_FILE=
